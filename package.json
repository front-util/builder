{
  "name": "@front-utils/builder",
  "version": "2.0.0",
  "description": "build configuration",
  "author": "IVGolubev",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/front-util/builder.git"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "check:lint": "eslint --max-warnings=0 --fix",
    "publish:lib": "npm publish --access public",
    "example:install": "npm --prefix example ci",
    "example:build": "npm --prefix example run build",
    "example:check:lint": "npm --prefix example run check:lint"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --no-stash",
    "preserveUnused": true
  },
  "publishConfig": {
    "access": "public",
    "ignore": [
      ".github/"
    ]
  },
  "keywords": [
    "Javascript",
    "Utils",
    "RsPack configuration"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.17.1",
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.8.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@front-utils/linter": "^2.1.0",
    "@module-federation/enhanced": "^2.8.1",
    "@module-federation/retry-plugin": "^2.8.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "compression-webpack-plugin": "^12.0.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.8.0",
    "lint-staged": "^17.2.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack-merge": "^6.0.1"
  },
  "peerDependencies": {
    "@rspack/cli": "^1.5.x",
    "@rspack/core": "^1.5.x",
    "@rspack/plugin-react-refresh": "^1.5.1",
    "@rsdoctor/rspack-plugin": "^1.3.12"
  },
  "optionalDependencies": {
    "@module-federation/enhanced": "*",
    "@module-federation/retry-plugin": "*",
    "compression-webpack-plugin": "*"
  }
}
